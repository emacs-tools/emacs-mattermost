*.token
*.pat
*.session
authinfo
.authinfo
secrets/
secret/
docker/secrets/

# Editor / OS
*~
\#*\#
.\#*
.DS_Store
Thumbs.db

# Emacs compiled/test artifacts
*.elc
tests/elisp/.ert-runner/
